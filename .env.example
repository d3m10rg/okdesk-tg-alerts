OKDESK_URL=https://sd.cpsupport.ru
OKDESK_LOGIN=your_login
OKDESK_PASSWORD=your_password

TELEGRAM_BOT_TOKEN=123456789:replace_me
# Numeric channel ID (-100...) or public channel username (@channel_name).
TELEGRAM_CHAT_ID=-1001234567890

# How often to check Okdesk. Minimum: 10 seconds.
POLL_INTERVAL_SECONDS=60
REQUEST_TIMEOUT_SECONDS=30
MAX_ISSUES_PER_CYCLE=100
STATE_PATH=/data/state.json
CREDENTIALS_PATH=/data/credentials.json
LOG_LEVEL=INFO
